# Example .env file for CommunityConnect Hub backend
# --------------------------------------------------
# Copy this file to `.env` in the same directory as server.js for local development.
#
#  NEWS_API_KEY is REQUIRED for live news feed in production.
#  Get your own API key at https://newsapi.org/
#
#  Do NOT commit your real .env file or key to a public repository!

NEWS_API_KEY=your_actual_newsapi_org_key_here

# Optional: Specify the backend port (defaults to 5000 if omitted)
# PORT=5000

